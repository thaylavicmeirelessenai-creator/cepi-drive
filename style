* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f2f2f2;
    min-height: 100vh;
}

.login-container {
    width: 100%;
    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;
}

.login-box {
    width: 380px;

    background: white;

    padding: 40px;

    border-radius: 12px;

    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
}

/* LOGO DO SENAI */

.logo {
    width: 100%;
    text-align: center;
    margin-bottom: 25px;
}

.logo img {
    width: 150px;
    height: auto;
    object-fit: contain;
}

/* TÍTULO */

.login-box h1 {
    text-align: center;
    color: #e30613;
    margin-bottom: 10px;
}

.login-box p {
    text-align: center;
    color: #666;
    margin-bottom: 30px;
}

/* CAMPOS */

label {
    display: block;
    margin-bottom: 8px;
    color: #333;
    font-weight: bold;
}

input {
    width: 100%;

    padding: 13px;

    margin-bottom: 20px;

    border: 1px solid #ccc;
    border-radius: 6px;

    font-size: 15px;

    outline: none;
}

input:focus {
    border-color: #e30613;
}

/* BOTÃO */

button {
    width: 100%;

    padding: 14px;

    border: none;
    border-radius: 6px;

    background: #e30613;
    color: white;

    font-size: 16px;
    font-weight: bold;

    cursor: pointer;
}

button:hover {
    background: #c9000b;
}